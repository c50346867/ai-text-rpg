{
    "id": "tutorial",
    "name": "初心者之旅",
    "name_en": "Beginner's Journey",
    "description": "新手冒险教程，引导玩家熟悉基本的游戏机制。从宁静的橡木镇出发，探索附近的迷雾森林。",
    "difficulty": "简单",
    "recommended_level": 1,
    "party_size": "1-4",
    "estimated_duration": "1-2小时",
    "background": "橡木镇最近感受到了来自迷雾森林的异变。附近的野兽变得暴躁，森林中传来奇怪的声音。村长请求冒险者调查此事。",
    "scenes": [
        {
            "id": "scene_001",
            "name": "橡木镇的召唤",
            "type": "dialogue",
            "description": "你站在橡木镇的广场上，村民们好奇地看着你这个陌生面孔。镇长从市政厅快步走出，脸上带着愁容。",
            "npcs": [
                {
                    "id": "mayor",
                    "name": "哈罗德镇长",
                    "description": "头发花白的老者，眼神中透着忧虑但带着希望",
                    "dialogue": {
                        "greeting": "感谢神明！终于有冒险者来了！",
                        "quest_offer": "最近森林里出了怪事。野兽变得异常凶猛，甚至攻击了镇上的猎人。我们需要勇敢的人去看看究竟发生了什么。",
                        "reward": "我们会准备50金币作为报酬，另外镇上的铁匠愿意为你免费打造一件装备。"
                    }
                }
            ],
            "choices": [
                {"text": "接受任务，前往迷雾森林", "next_scene": "scene_002", "action": "quest_accept"},
                {"text": "拒绝并离开小镇", "next_scene": "scene_end", "action": "leave_town"},
                {"text": "先打听更多关于森林的情报", "next_scene": "scene_001a", "action": "gather_info"}
            ]
        },
        {
            "id": "scene_001a",
            "name": "情报收集",
            "type": "exploration",
            "description": "你在镇上四处打听，从酒馆老板娘那里得知森林深处曾经有一座古庙，最近晚上能听到庙里传出诡异的蓝光。猎人老王说那些发狂的野兽身上都有轻微的暗蚀痕迹。",
            "choices": [
                {"text": "准备妥当后前往迷雾森林", "next_scene": "scene_002", "action": "proceed"},
                {"text": "去铁匠铺补充装备", "next_scene": "scene_001b", "action": "visit_blacksmith"}
            ]
        },
        {
            "id": "scene_001b",
            "name": "铁匠铺",
            "type": "exploration",
            "description": "铁匠是个壮实的矮人工匠，正在叮叮当当敲打一块铁胚。看到你进来，他放下锤子。",
            "npcs": [
                {
                    "id": "blacksmith",
                    "name": "铁匠布罗尼",
                    "description": "满身肌肉的矮人铁匠，胡须和围裙上满是铁屑",
                    "dialogue": {
                        "greeting": "冒险者？呵，你这身装备可不够看！",
                        "offer": "我这有把不错的铁剑，算你便宜点——10金币。或者你可以花5金币买一套皮甲。"
                    }
                }
            ],
            "choices": [
                {"text": "购买铁剑 (10金币)", "next_scene": "scene_002", "action": "buy_sword", "condition": "gold>=10"},
                {"text": "购买皮甲 (5金币)", "next_scene": "scene_002", "action": "buy_armor", "condition": "gold>=5"},
                {"text": "不买，直接前往森林", "next_scene": "scene_002", "action": "decline"}
            ]
        },
        {
            "id": "scene_002",
            "name": "迷雾森林入口",
